# Configurações Globais do Nacci.Edit
# Copie este arquivo para .env e preencha suas chaves gratuitas (opcional, mas recomendado)

# 1. Pexels API (100% Gratuita - pegue em https://www.pexels.com/api/ )
PEXELS_API_KEY=

# 2. Pixabay API (100% Gratuita - pegue em https://pixabay.com/api/docs/ )
PIXABAY_API_KEY=

# Observação:
# - Wikimedia Commons, NASA Media API e Openverse funcionam SEM chave de API!
# - YouTube e Instagram Reels funcionam via yt-dlp local SEM chave de API!
